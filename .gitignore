# Ignore all the subdirectories inside the models folder:
ros_ws/src/uav_bringup/models/*

# Ignore the files that have been saved form the lfights:
ros_ws/src/uav_bringup/saving_data/*

# Ignore the installation folders that are created from the installation:
ros_ws/build/*
ros_ws/install/*
ros_ws/log/*

# Ignore teh package created by matlab msg:
ros_ws/src/matlab_msg_gen/*

# Ignore compiled MATLAB object files
*.o
ros_ws/src/uav_dynamics/src/matlab_obj/*

# Ignore the keys used for some creation:
ros_ws/src/uav_bringup/config/world_creation.yaml

# Ignore the folder with the encouters as is too heavy:
# Use a wildcard to catch this file regardless of path depth
**/encounter_data/*.csv
**/encounter_data/terminal_encounter_state_data_20200630/
